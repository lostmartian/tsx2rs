{
  "name": "@tsx2rs/runtime",
  "version": "0.0.0",
  "private": true,
  "description": "tsx2rs runtime: the server that serves an app's compiled routes and hands the rest to Next.js (tsx2rs start), and the encoder library",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lostmartian/tsx2rs.git",
    "directory": "packages/runtime"
  },
  "type": "module",
  "exports": {
    "./encode": "./src/encode.ts",
    "./capture": "./src/capture.ts",
    "./server": "./src/server.ts",
    "./cli": "./src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "next": "catalog:",
    "react": "catalog:"
  },
  "dependencies": {
    "@next/routing": "16.4.6",
    "@tsx2rs/native": "workspace:*"
  },
  "peerDependencies": {
    "next": "16.4.5"
  },
  "bin": {
    "tsx2rs": "./src/cli.ts"
  }
}
