// tsx2rs encoder (generated): writes the records as the engine's input (ADR-0016).
import { ENTRY_KEYS, NO_KEYS, Input, attrs, call, html, island, node, primitive, reference, rootKey, style, value } from "@tsx2rs/runtime/encode";

export function encode(record, data, islands) {
  const w = new Input();
  t0(w, record, ENTRY_KEYS, data, islands);
  return w.finish();
}

function t0(w, r, k, data, islands) {
  const [ret1, rec2] = r[0];
  if (ret1 === 0) {
    w.condition(true);
  }
  else {
    w.condition(false);
    const wrap3 = k.implicit && rec2[0][0] !== null;
    w.condition(wrap3);
    const el4 = rec2[0];
    primitive(w, rootKey(k, el4[0]));
    primitive(w, el4[1]);
    style(w, el4[2]);
    const branch5 = el4[3];
    w.condition(branch5[0]);
    if (branch5[0]) {
    }
    else {
    }
    const items6 = el4[4];
    w.u32(items6.length);
    for (const item7 of items6) {
      const el8 = item7[0];
      primitive(w, el8[0]);
      node(w, el8[1]);
    }
    const items9 = el4[5];
    w.u32(items9.length);
    for (const item10 of items9) {
      w.condition(true);
    }
    const el11 = el4[6];
    primitive(w, el11[0]);
    attrs(w, el11[1]);
    call(w, NO_KEYS, el4[7], data[0], (w, r, k) => {
      const wrap12 = k.implicit && r[0][0] !== null;
      w.condition(wrap12);
      const el13 = r[0];
      primitive(w, rootKey(k, el13[0]));
      node(w, el13[1][0]);
      node(w, el13[2]);
      w.condition(wrap12);
    });
    call(w, NO_KEYS, el4[8], data[1], (w, r, k) => {
      const wrap14 = k.implicit && r[0][0] !== null;
      w.condition(wrap14);
      const el15 = r[0];
      primitive(w, rootKey(k, el15[0]));
      const branch16 = el15[1];
      w.condition(branch16[0]);
      if (branch16[0]) {
        call(w, NO_KEYS, branch16[1][0], data[1], (w, r, k) => t1(w, r, k, data, islands));
      }
      else {
        node(w, branch16[1][0]);
      }
      w.condition(wrap14);
    });
    const el17 = el4[9];
    const island18 = island(islands, 0, el17[1]);
    reference(w, island18.ref);
    primitive(w, el17[0]);
    value(w, el17[1]["href"]);
    value(w, el17[1]["prefetch"]);
    html(w, island18.before);
    node(w, el17[2]);
    html(w, island18.after);
    const el19 = el4[10];
    const island20 = island(islands, 0, el19[1]);
    reference(w, island20.ref);
    primitive(w, el19[0]);
    value(w, el19[1]["href"]);
    html(w, island20.before);
    w.condition(wrap3);
  }
}

function t1(w, r, k, data, islands) {
  const wrap21 = k.implicit && r[0][0] !== null;
  w.condition(wrap21);
  const el22 = r[0];
  primitive(w, rootKey(k, el22[0]));
  const branch23 = el22[1];
  w.condition(branch23[0]);
  if (branch23[0]) {
    call(w, NO_KEYS, branch23[1][0], data[1], (w, r, k) => t1(w, r, k, data, islands));
  }
  else {
    node(w, branch23[1][0]);
  }
  w.condition(wrap21);
}
